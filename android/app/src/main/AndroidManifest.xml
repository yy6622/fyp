<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Used by geolocator (lib/services/location_service.dart) to
         suggest the nearest departure airport for Home Airport in
         Account Setting. ACCESS_COARSE_LOCATION alone is enough for a
         "which city am I near" suggestion; FINE is requested too since
         the OS may grant only coarse either way, and coarse is what
         the app actually needs. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Used by mobile_scanner (lib/views/group/scan_qr_page.dart) to
         scan a trip's invite QR code shown on its Group Info page. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Android 13+ requires this to be declared before a push
         notification can be shown in the system tray at all,
         requested at runtime by NotificationService.init()
         (lib/services/notification_service.dart), via
         FirebaseMessaging's own permission request. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="voya"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- NOTE: deliberately NOT using android:screenOrientation="portrait"
                 here. On targetSdk 27+, a fixed activity-level orientation
                 crashes with "IllegalStateException: Only fullscreen
                 activities can request orientation" the moment a plugin's
                 own camera/picker activity (image_picker's camera capture,
                 in this app's case) calls setRequestedOrientation() on
                 launch, which is exactly what "take a photo" does. The
                 Dart-level SystemChrome.setPreferredOrientations() lock in
                 main.dart achieves the same portrait-only behaviour for
                 this app's own UI without that native conflict. -->
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
